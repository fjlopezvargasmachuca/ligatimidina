# Desarrollo local. Copia este archivo a .env y usa valores propios.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# Solo para tests/CI sin PostgreSQL. Producción debe usar PostgreSQL.
DJANGO_USE_SQLITE=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_NAME=ligatimidina
DB_USER=ligatimidina_user
DB_PASSWORD=una-clave-fuerte-y-exclusiva
DB_HOST=localhost
DB_PORT=5432

# Producción HTTPS (activa estos valores detrás de Nginx/Caddy/Traefik con TLS válido)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=False
DRF_ANON_RATE=300/hour
DRF_USER_RATE=2000/day
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DRF_LOGIN_RATE=10/minute
DRF_REGISTER_RATE=5/hour

# Correo de producción (en desarrollo se usa la consola)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=noreply@ligatimidina.local

DRF_BINDER_CARD_RATE=60/hour
