# Desarrollo local. Copia este archivo a .env y usa valores propios.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# Solo para tests/CI sin PostgreSQL. Producción debe usar PostgreSQL.
DJANGO_USE_SQLITE=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_NAME=ligatimidina
DB_USER=ligatimidina_user
DB_PASSWORD=una-clave-fuerte-y-exclusiva
DB_HOST=localhost
DB_PORT=5432

# Producción HTTPS (activa estos valores detrás de Nginx/Caddy/Traefik con TLS válido)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=False
DRF_ANON_RATE=300/hour
DRF_USER_RATE=2000/day
